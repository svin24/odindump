{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mkdir",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "build"
            ]
        },
        {
            "label": "build",
            "type": "shell",
            "command": "odin",
            "args": [
                "build",
                "./src",
                "-debug",
                "-out:build/debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build",
            "dependsOn": [
                "mkdir",
                "build"
            ],
            "dependsOrder": "sequence"
        }
    ]
}